enum UserRole {
  BUYER_RENTER
  LANDLORD
  DEVELOPER
  AGENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole @default(BUYER_RENTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties              Property[]               @relation("PropertyOwner")
  submittedDocuments      PropertyDocument[]        @relation("DocumentSubmitter")
  communityReports        CommunityReport[]         @relation("ReportAuthor")
  cooperativeMemberships  CooperativeMembership[]
  ratingsGiven            LandlordRating[]          @relation("RatingAuthor")
  ratingsReceived         LandlordRating[]          @relation("RatingTarget")
  conversationsIn         ConversationParticipant[]
  messagesSent            Message[]
  notifications           Notification[]
}
