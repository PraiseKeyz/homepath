PORT=3001
NODE_ENV=development

# Database — native local Postgres. Create the role/db below, or point this at
# whatever Postgres you already run locally.
DATABASE_URL=postgresql://homepath:homepath_dev_password@localhost:5432/homepath

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-development
JWT_EXPIRES_IN=7d

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# Gemini API — used only for Trust Score explanation text (see docs/ARCHITECTURE.md §2)
GEMINI_API_KEY=
